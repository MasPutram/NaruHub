# Upstash Redis (free tier: https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Access keys (comma-separated for multi-tenant)
# Each key = separate tenant, with isolated data in the dashboard.
# Single key also works (backward compatible).
ACCESS_KEYS=KEY-ONE,KEY-TWO,KEY-THREE

# HMAC secret for session tokens (generate a random string)
AUTH_SECRET=your-random-secret-here

# URL local poster_server (tunnel URL, untuk generate poster & restart)
# Kosongkan kalau ga butuh fitur poster dari Vercel dashboard
POSTER_SERVER_URL=https://xxx.trycloudflare.com
